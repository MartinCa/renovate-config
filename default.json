{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":automergeTesters",
    ":automergeLinters",
    ":semanticCommits"
  ],
  "assignees": ["MartinCa"],
  "assignAutomerge": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "pinDigests"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION env vars in workflows, annotated with a `# renovate:` comment on the preceding line.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Z0-9_]+_VERSION\\s*:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION env vars in compose files, annotated with a `# renovate:` comment.",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+-\\s+[A-Z0-9_]+_VERSION\\s*=\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION ARGs in Dockerfiles, annotated with a `# renovate:` comment.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+ARG\\s+[A-Z0-9_]+_VERSION=[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Git commit SHAs pinned as *_COMMIT ARGs in Dockerfiles, tracking a source repo's branch via git-refs.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>[^\\s]+?) branch=(?<currentValue>[^\\s]+?)\\s+ARG\\s+[A-Z0-9_]+_COMMIT=[\"']?(?<currentDigest>[a-f0-9]{7,40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ]
}
