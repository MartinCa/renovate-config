{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":automergeTesters",
    ":automergeLinters",
    ":semanticCommits",
    "./lefthook"
  ],
  "assignees": [
    "MartinCa"
  ],
  "assignAutomerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "pinDigests"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "uv",
        "ghcr.io/astral-sh/uv"
      ],
      "groupName": "uv"
    },
    {
      "description": "Skip the release-age wait for my own container images on GHCR: I publish and review them myself. Scoped to the docker datasource so a same-named package from another ecosystem is not exempted. Docker Hub is deliberately not listed: consumed images of mine are published to GHCR.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/martinca/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip the release-age wait for my own npm scope (published and reviewed by me). Scoped to the npm datasource.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@martinrun/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip the release-age wait for my own GitHub-hosted sources (actions, releases, tags such as MartinCa/lefthook-configs). Scoped to the GitHub datasources so a same-named package elsewhere is not exempted.",
      "matchDatasources": [
        "github-tags",
        "github-releases"
      ],
      "matchPackageNames": [
        "MartinCa/**"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION env vars in workflows, annotated with a `# renovate:` comment on the preceding line.",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Z0-9_]+_VERSION\\s*:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION env vars in compose files, annotated with a `# renovate:` comment.",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+-\\s+[A-Z0-9_]+_VERSION\\s*=\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned as *_VERSION ARGs in Dockerfiles, annotated with a `# renovate:` comment.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+ARG\\s+[A-Z0-9_]+_VERSION=[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Git commit SHAs pinned as *_COMMIT ARGs in Dockerfiles, tracking a source repo's branch via git-refs.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]+$/"
      ],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>[^\\s]+?) branch=(?<currentValue>[^\\s]+?)\\s+ARG\\s+[A-Z0-9_]+_COMMIT=[\"']?(?<currentDigest>[a-f0-9]{7,40})[\"']?"
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ]
}
