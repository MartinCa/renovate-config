{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":automergeTesters",
    ":automergeLinters",
    ":semanticCommits"
  ],
  "assignees": ["MartinCa"],
  "assignAutomerge": true,
  "minimumReleaseAge": "4 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional"
}
